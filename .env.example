# --- Obligatoire -------------------------------------------------------------
# Token du bot, donné par @BotFather sur Telegram.
TELEGRAM_BOT_TOKEN=
# Clé du modèle : remplis l'UNE des deux.
# - Clé OpenRouter (https://openrouter.ai/settings/keys) : Koto passe alors par OpenRouter.
OPENROUTER_API_KEY=
# - Ou clé API Anthropic directe (https://platform.claude.com).
ANTHROPIC_API_KEY=

# --- Accès ---------------------------------------------------------------------
# Identifiants Telegram des admins, séparés par des virgules (accès sans invitation,
# budget illimité, /stats). Si tu ne connais pas le tien, écris au bot : il te le donne.
ADMIN_TELEGRAM_IDS=
# invite = sur invitation (recommandé) | open = tout le monde | closed = plus d'inscriptions
REGISTRATION_MODE=invite
# Nombre de liens d'invitation donnés à chaque nouvel utilisateur.
INVITES_PER_USER=3
# Budget API max par utilisateur et par jour, en dollars (les admins n'ont pas de limite).
DAILY_BUDGET_USD=0.50

# --- Agent ---------------------------------------------------------------------
# anthropic | openrouter — vide = OpenRouter si OPENROUTER_API_KEY est rempli, sinon Anthropic.
LLM_PROVIDER=
# Format Anthropic (claude-opus-5-5) ou OpenRouter (anthropic/claude-opus-5.5) : converti au besoin.
KOTO_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — low garde des réponses rapides pour le chat.
KOTO_EFFORT=low
# on | off — recherche et lecture de pages web (facturées en plus des tokens).
KOTO_WEB=on

# --- Gmail et Google Agenda (via Composio, en MCP) ----------------------------------
# Clé API Composio : https://dashboard.composio.dev/~/project/settings/api-keys
# Vide = Gmail et Google Agenda désactivés. Chaque personne relie ses comptes avec /connecter.
COMPOSIO_API_KEY=

# --- Messages vocaux ---------------------------------------------------------------
# on | off — transcription via OpenRouter (nécessite OPENROUTER_API_KEY).
KOTO_VOICE=on
KOTO_TRANSCRIBE_MODEL=google/gemini-2.5-flash-lite

# --- Réponses vocales (synthèse via OpenRouter) -------------------------------------
# on | off — Koto répond en vocal : à un vocal par défaut ; brief, rappels ou toutes les réponses sur demande.
KOTO_TTS=on
# Voix principale, gratuite. Quota des modèles gratuits, pour tout le compte OpenRouter :
# 50 requêtes/jour, ou 1 000 si le compte a acheté au moins 10 $ de crédits. Voix vide = voix par défaut.
KOTO_TTS_MODEL=fish-audio/s2.1-pro-free:free
KOTO_TTS_VOICE=
# Voix de secours quand la gratuite est épuisée : Kokoro, ~0,0006 $ les 1 000 caractères (off = aucune).
# Plus naturelle mais payante : microsoft/mai-voice-2.1-flash + fr-FR-Soleil:MAI-Voice-2.1-Flash (~0,015 $ / 1 000 caractères).
KOTO_TTS_FALLBACK_MODEL=hexgrad/kokoro-82m
KOTO_TTS_FALLBACK_VOICE=ff_siwis

# --- Navigateur (tâches web) --------------------------------------------------------
# on | off — Koto agit sur des sites dans un vrai navigateur (Chrome piloté par Playwright).
KOTO_BROWSER=on
# on = fenêtre visible : le propriétaire peut prendre la main (connexion, CAPTCHA).
KOTO_BROWSER_HEADED=off
# chrome = le Chrome installé, avec repli automatique sur Chromium s'il manque (serveur Linux ARM…) ;
# chromium = celui de Playwright (npx playwright install --with-deps chromium).
KOTO_BROWSER_CHANNEL=chrome
# Modèle des tâches web (vide = KOTO_MODEL). Sonnet est plus fiable sur les longues tâches.
KOTO_BROWSER_MODEL=
KOTO_BROWSER_MAX_STEPS=40
KOTO_BROWSER_MAX_COST_USD=0.30

# --- 1Password (facultatif, propriétaire du bot uniquement) ------------------------
# Option 1 : appli de bureau 1Password ; chaque accès y est approuvé. Nom du compte affiché
# en haut à gauche de l'appli (Réglages > Développeur > « Intégrer avec d'autres applis »).
OP_ACCOUNT=
# Option 2 : jeton de compte de service (offres Teams/Business), limité à un coffre dédié.
OP_SERVICE_ACCOUNT_TOKEN=
# Ton identifiant Telegram : seul ce compte peut utiliser 1Password.
OP_OWNER_TELEGRAM_ID=

# --- Missions (suivis de fond sur plusieurs jours) ----------------------------------
# on | off — « surveille ce vol et préviens-moi s'il passe sous 600 € » : Koto travaille en arrière-plan,
# passage après passage, et ne prévient que s'il y a un résultat. Liste et arrêt : /missions.
KOTO_MISSIONS=on
# Modèle des passages (vide = KOTO_MODEL).
KOTO_MISSION_MODEL=
# Heures minimum entre deux passages d'une même mission.
KOTO_MISSION_MIN_HOURS=1
# Plafond d'une mission quand la personne n'en donne pas (2 $ au plus), et plafond d'un passage.
# Chaque passage compte aussi dans le budget du jour (DAILY_BUDGET_USD).
KOTO_MISSION_MAX_COST_USD=0.25
KOTO_MISSION_RUN_MAX_COST_USD=0.05

# --- Mémoire longue ----------------------------------------------------------------
# La recherche dans tout l'historique (search_history) et les fiches des documents sont gratuites, toujours actives.
# on | off — ménage de la mémoire : doublons fusionnés, faits périmés archivés (jamais effacés), une fois par
# semaine au plus si elle a changé, ou dès 60 souvenirs. Environ 0,001 $ le ménage, compté dans le budget du jour.
KOTO_MEMORY_CONSOLIDATION=on
# Modèle du ménage (vide = le moins cher connu, Claude Haiku 5.5, quel que soit KOTO_MODEL).
KOTO_MEMORY_MODEL=

# --- Valeurs par défaut des nouveaux utilisateurs -------------------------------
DEFAULT_TIMEZONE=Indian/Antananarivo
DEFAULT_BRIEF_TIME=07:30

DATABASE_PATH=./data/koto.db
# Sauvegardes quotidiennes de la base (API backup de SQLite), gardées dans data/backups. 0 = aucune.
KOTO_BACKUP_KEEP=14

# --- Appels en direct (mini-app Telegram) ------------------------------------------
# Adresse HTTPS publique qui mène au serveur d'appel de Koto (tunnel Cloudflare, proxy…).
# Vide = appels désactivés. Ex : KOTO_PUBLIC_URL=https://koto.ton-domaine.com
KOTO_PUBLIC_URL=
# Où le serveur d'appel écoute (en local : le tunnel s'y branche).
KOTO_CALL_PORT=8787
KOTO_CALL_HOST=127.0.0.1

# --- Avancé : uniquement pour les tests système (faux serveurs locaux) --------------
# TELEGRAM_API_ROOT=https://api.telegram.org
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# KOTO_SCHEDULER_INTERVAL_MS=20000
